<?xml version="1.0" encoding="utf-8"?>
<!-- Template. android/build.sh substitutes @APP_PKG@ and @APP_ORIENTATION@
     from the selected app config in android/apps/ and writes the result to
     android/build/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@APP_PKG@"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Fully offline: no INTERNET permission is requested. -->

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <activity
            android:name="com.webapp.shell.MainActivity"
            android:exported="true"
            android:screenOrientation="@APP_ORIENTATION@"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
